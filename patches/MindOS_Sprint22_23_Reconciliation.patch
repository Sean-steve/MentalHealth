+import { describe, it, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { OutcomeTrendEngine } from '../mindos/outcomes/trends/trend_engine.js';
+import { ClinicalChangeRuleRegistry } from '../mindos/outcomes/trends/clinical_change_rules.js';
+import {
+  OutcomeDirectionality,
+  OutcomeMeasureType,
+  OutcomeValueType,
+  OutcomeMeasurementValidity,
+  ClinicalProvenance,
+  OutcomeTrendState
+} from '../mindos/outcomes/domain/types.js';
+import { OutcomeSeries } from '../mindos/outcomes/domain/entities.js';
+
+function series(directionality: OutcomeDirectionality, values: number[]): OutcomeSeries {
+  const now = new Date().toISOString();
+  return {
+    subject_user_id: 'user-s23', measure_code: 'TEST_MEASURE',
+    measure_definition: {
+      id: 'measure-test', measure_code: 'TEST_MEASURE', name: 'Test Measure', description: 'Synthetic only',
+      measure_type: OutcomeMeasureType.PROFESSIONAL_RATING, unit: 'score', value_type: OutcomeValueType.DECIMAL,
+      directionality, population: 'TEST', jurisdiction: 'KE', source_domain: 'test',
+      comparability_policy_id: 'policy-test', status: 'ACTIVE', created_at: now
+    },
+    measurements: values.map((value, i) => ({
+      id: `m-${i}`, subject_user_id: 'user-s23', measure_definition_id: 'measure-test', measure_code: 'TEST_MEASURE',
+      value, unit: 'score', measured_at: new Date(Date.now()+i*1000).toISOString(), recorded_at: now,
+      source_type: 'TEST', source_reference: `source-${i}`, provenance: ClinicalProvenance.PROFESSIONAL_RECORDED,
+      validity_status: OutcomeMeasurementValidity.VALID, created_at: now
+    })),
+    comparability_status: 'COMPARABLE', baseline_measurement_id: 'm-0', latest_measurement_id: `m-${values.length-1}`,
+    series_version: 1
+  };
+}
+
+describe('MindOS Sprint 23 reconciliation: governed longitudinal outcome interpretation', () => {
+  beforeEach(() => ClinicalChangeRuleRegistry.clear());
+
+  it('returns UNKNOWN instead of inventing clinical thresholds when no approved rule exists', () => {
+    const trend = OutcomeTrendEngine.evaluateSeries(series(OutcomeDirectionality.LOWER_IS_BETTER, [10, 14]));
+    assert.equal(trend.trend_state, OutcomeTrendState.UNKNOWN);
+    assert.equal(trend.is_clinically_significant, false);
+    assert.equal(trend.requires_review, true);
+    assert.ok(trend.reason_codes.includes('CLINICAL_CHANGE_RULE_NOT_CONFIGURED'));
+  });
+
+  it('uses an explicitly approved, versioned clinical rule when one is registered', () => {
+    ClinicalChangeRuleRegistry.register({
+      rule: { measure_code: 'TEST_MEASURE', mcid: 3, critical_worsening_threshold: 6 },
+      clinical_artifact_id: 'clinical-artifact-test', clinical_artifact_version: '1',
+      approved_by: 'qualified-test-reviewer', approved_at: new Date().toISOString(), policy_version: 'test-policy-v1'
+    });
+    const trend = OutcomeTrendEngine.evaluateSeries(series(OutcomeDirectionality.LOWER_IS_BETTER, [10, 14]));
+    assert.equal(trend.trend_state, OutcomeTrendState.WORSENING);
+    assert.equal(trend.is_clinically_significant, true);
+    assert.ok(trend.reason_codes.some(code => code.startsWith('GOVERNED_RULE:')));
+  });
+
+  it('does not invent a target range for TARGET_RANGE measures', () => {
+    ClinicalChangeRuleRegistry.register({
+      rule: { measure_code: 'TEST_MEASURE', mcid: 1 },
+      clinical_artifact_id: 'clinical-artifact-test', clinical_artifact_version: '1',
+      approved_by: 'qualified-test-reviewer', approved_at: new Date().toISOString(), policy_version: 'test-policy-v1'
+    });
+    const trend = OutcomeTrendEngine.evaluateSeries(series(OutcomeDirectionality.TARGET_RANGE, [5, 7]));
+    assert.equal(trend.trend_state, OutcomeTrendState.UNKNOWN);
+    assert.ok(trend.reason_codes.includes('APPROVED_TARGET_RANGE_NOT_CONFIGURED'));
+  });
+});