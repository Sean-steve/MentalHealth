+-- ==============================================================================
+-- MINDOS CANONICAL MIGRATION: 021_canonical_longitudinal_outcomes.sql
+-- Sprint 23 reconciliation: Longitudinal Clinical Record & Measurement-Based Care.
+-- Clinical change rules are NOT seeded here. They must be loaded from approved,
+-- versioned Clinical Governance artifacts.
+-- ==============================================================================
+
+-- UP --
+CREATE TABLE IF NOT EXISTS longitudinal_clinical_records (
+  id UUID PRIMARY KEY,
+  subject_user_id UUID NOT NULL UNIQUE REFERENCES users(id) ON DELETE RESTRICT,
+  status VARCHAR(40) NOT NULL DEFAULT 'ACTIVE',
+  jurisdiction CHAR(2) NOT NULL DEFAULT 'KE',
+  record_version INTEGER NOT NULL DEFAULT 1,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE TABLE IF NOT EXISTS clinical_timeline_entries (
+  id UUID PRIMARY KEY,
+  subject_user_id UUID NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
+  event_type VARCHAR(120) NOT NULL,
+  occurred_at TIMESTAMPTZ NOT NULL,
+  recorded_at TIMESTAMPTZ NOT NULL,
+  source_domain VARCHAR(80) NOT NULL,
+  source_type VARCHAR(80) NOT NULL,
+  source_id VARCHAR(160) NOT NULL,
+  provenance VARCHAR(60) NOT NULL,
+  clinical_significance VARCHAR(60),
+  safety_significance VARCHAR(60),
+  summary_reference VARCHAR(240),
+  visibility_scope VARCHAR(60) NOT NULL,
+  invalidated_at TIMESTAMPTZ,
+  invalidation_reason VARCHAR(240),
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  UNIQUE(source_domain, source_type, source_id, event_type)
+);
+CREATE INDEX IF NOT EXISTS idx_clinical_timeline_subject_time ON clinical_timeline_entries(subject_user_id, occurred_at DESC, id);
+CREATE INDEX IF NOT EXISTS idx_clinical_timeline_type ON clinical_timeline_entries(subject_user_id, event_type, occurred_at DESC);
+
+CREATE TABLE IF NOT EXISTS outcome_measure_definitions (
+  id UUID PRIMARY KEY,
+  measure_code VARCHAR(120) NOT NULL UNIQUE,
+  name VARCHAR(200) NOT NULL,
+  description TEXT NOT NULL,
+  measure_type VARCHAR(80) NOT NULL,
+  unit VARCHAR(80) NOT NULL,
+  value_type VARCHAR(40) NOT NULL,
+  directionality VARCHAR(60) NOT NULL,
+  population VARCHAR(120) NOT NULL,
+  jurisdiction CHAR(2) NOT NULL,
+  source_domain VARCHAR(80) NOT NULL,
+  clinical_artifact_id VARCHAR(160),
+  clinical_artifact_version VARCHAR(120),
+  comparability_policy_id UUID NOT NULL,
+  status VARCHAR(40) NOT NULL,
+  min_value NUMERIC,
+  max_value NUMERIC,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE TABLE IF NOT EXISTS measure_comparability_policies (
+  id UUID PRIMARY KEY,
