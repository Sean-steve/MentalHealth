+  recorded_at TIMESTAMPTZ NOT NULL,
+  source_type VARCHAR(80) NOT NULL,
+  source_reference VARCHAR(200) NOT NULL,
+  instrument_version VARCHAR(120),
+  provenance VARCHAR(60) NOT NULL,
+  validity_status VARCHAR(60) NOT NULL,
+  invalidation_reason VARCHAR(240),
+  invalidated_at TIMESTAMPTZ,
+  care_relationship_id UUID,
+  care_plan_id UUID,
+  care_goal_id UUID,
+  clinical_encounter_id UUID,
+  recorded_by VARCHAR(160),
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  UNIQUE(source_type, source_reference, measure_code)
+);
+CREATE INDEX IF NOT EXISTS idx_outcome_measurements_subject_measure_time ON outcome_measurements(subject_user_id, measure_code, measured_at DESC);
+CREATE INDEX IF NOT EXISTS idx_outcome_measurements_source ON outcome_measurements(source_type, source_reference);
+
+CREATE TABLE IF NOT EXISTS outcome_baselines (
+  id UUID PRIMARY KEY,
+  subject_user_id UUID NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
+  measure_code VARCHAR(120) NOT NULL,
+  baseline_measurement_id UUID NOT NULL REFERENCES outcome_measurements(id) ON DELETE RESTRICT,
+  baseline_value_json JSONB NOT NULL,
+  baseline_type VARCHAR(60) NOT NULL,
+  established_at TIMESTAMPTZ NOT NULL,
+  established_by VARCHAR(160) NOT NULL,
+  override_reason VARCHAR(240),
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  UNIQUE(subject_user_id, measure_code)
+);
+
+CREATE TABLE IF NOT EXISTS outcome_reviews (
+  id UUID PRIMARY KEY,
+  subject_user_id UUID NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
+  care_relationship_id UUID NOT NULL,
+  care_plan_id UUID,
+  review_type VARCHAR(80) NOT NULL,
+  status VARCHAR(60) NOT NULL,
+  reviewer_id UUID,
+  measurement_refs JSONB NOT NULL DEFAULT '[]',
+  trend_refs JSONB NOT NULL DEFAULT '[]',
+  scheduled_for TIMESTAMPTZ,
+  started_at TIMESTAMPTZ,
+  completed_at TIMESTAMPTZ,
+  decision VARCHAR(80),
+  reason_codes JSONB NOT NULL DEFAULT '[]',
+  clinical_notes_reference VARCHAR(240),
+  recommended_actions JSONB NOT NULL DEFAULT '[]',
+  snapshot_id UUID,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE INDEX IF NOT EXISTS idx_outcome_reviews_subject_status ON outcome_reviews(subject_user_id, status, scheduled_for);
+
+CREATE TABLE IF NOT EXISTS outcome_snapshots (
+  id UUID PRIMARY KEY,
+  review_id UUID NOT NULL UNIQUE REFERENCES outcome_reviews(id) ON DELETE RESTRICT,
+  subject_user_id UUID NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
+  measure_states JSONB NOT NULL,
+  trend_states JSONB NOT NULL,
+  care_plan_version_id UUID,
+  frozen_at TIMESTAMPTZ NOT NULL,
+  hash VARCHAR(128) NOT NULL
+);
+ALTER TABLE outcome_reviews
+  ADD CONSTRAINT fk_outcome_reviews_snapshot
+  FOREIGN KEY(snapshot_id) REFERENCES outcome_snapshots(id) DEFERRABLE INITIALLY DEFERRED;
+
+CREATE TABLE IF NOT EXISTS outcome_alerts (
+  id UUID PRIMARY KEY,
+  subject_user_id UUID NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
+  care_relationship_id UUID,
+  alert_type VARCHAR(80) NOT NULL,
+  severity VARCHAR(40) NOT NULL,
+  measure_code VARCHAR(120),
+  measurement_id UUID REFERENCES outcome_measurements(id) ON DELETE SET NULL,
+  trend_reference VARCHAR(240),
+  status VARCHAR(60) NOT NULL,
+  generated_at TIMESTAMPTZ NOT NULL,
+  review_due_at TIMESTAMPTZ,
+  assigned_to UUID,
+  policy_version VARCHAR(80),
+  resolved_at TIMESTAMPTZ,
+  resolution_reason VARCHAR(240)
+);
+CREATE INDEX IF NOT EXISTS idx_outcome_alerts_subject_status ON outcome_alerts(subject_user_id, status, severity);
+
+-- Clinical change rules intentionally have no numeric seed values. Only approved
+-- governance artifacts may populate this table at runtime/migration time.
+CREATE TABLE IF NOT EXISTS governed_clinical_change_rules (
+  id UUID PRIMARY KEY,
+  measure_code VARCHAR(120) NOT NULL,
+  rule_json JSONB NOT NULL,
+  clinical_artifact_id VARCHAR(160) NOT NULL,
+  clinical_artifact_version VARCHAR(120) NOT NULL,
+  approved_by VARCHAR(160) NOT NULL,
+  approved_at TIMESTAMPTZ NOT NULL,
+  policy_version VARCHAR(80) NOT NULL,
+  status VARCHAR(40) NOT NULL DEFAULT 'ACTIVE',
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  UNIQUE(measure_code, clinical_artifact_id, clinical_artifact_version)
+);
+
+-- DOWN --
+DROP TABLE IF EXISTS governed_clinical_change_rules CASCADE;
+DROP TABLE IF EXISTS outcome_alerts CASCADE;
+ALTER TABLE outcome_reviews DROP CONSTRAINT IF EXISTS fk_outcome_reviews_snapshot;
+DROP TABLE IF EXISTS outcome_snapshots CASCADE;
+DROP TABLE IF EXISTS outcome_reviews CASCADE;
+DROP TABLE IF EXISTS outcome_baselines CASCADE;
+DROP TABLE IF EXISTS outcome_measurements CASCADE;
+DROP TABLE IF EXISTS measure_comparability_policies CASCADE;
+DROP TABLE IF EXISTS outcome_measure_definitions CASCADE;
