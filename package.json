{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "setup": "tsx scripts/bootstrap.ts",
    "verify": "tsx scripts/verify.ts",
    "test": "tsx --test \"tests/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:unit": "tsx --test \"tests/*.test.ts\"",
    "test:integration": "tsx --test \"tests/database_safety.test.ts\" \"tests/environment_config.test.ts\"",
    "test:e2e": "tsx --test \"tests/e2e/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx mindos/platform/database/cli.ts apply",
    "db:status": "tsx mindos/platform/database/cli.ts status",
    "db:seed": "tsx mindos/platform/database/cli.ts seed",
    "db:reset-dev": "tsx mindos/platform/database/cli.ts reset-dev",
    "db:validate-migrations": "tsx mindos/platform/database/cli.ts validate",
    "build:metadata": "tsx scripts/build_metadata.ts",
    "build:sbom": "tsx scripts/generate_sbom.ts",
    "scan:secrets": "tsx scripts/scan_secrets.ts",
    "scan:dependencies": "tsx scripts/scan_dependencies.ts",
    "stop": "echo 'All services stopped'",
    "clean": "rm -rf dist server.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}