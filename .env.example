# ==============================================================================
# MINDOS PLATFORM CANONICAL CONFIGURATION TEMPLATE (.env.example)
# Authority: Master Architecture Index Section 6 & Appendix M (ADR-001, ADR-004)
# SAFE TEMPLATE ONLY - NEVER COMMIT SECRETS OR REAL CREDENTIALS
# ==============================================================================

# 1. APP CONFIGURATION
MINDOS_ENV="development" # local | development | test | staging | production
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
DEBUG="false"
DEFAULT_COUNTRY_CODE="KE"

# 2. DATABASE (PostgreSQL 15+ Primary Operational Store)
DATABASE_URL="postgresql://mindos_user:mindos_pass@localhost:5432/mindos_db"
DB_POOL_MIN="2"
DB_POOL_MAX="10"
DB_SSL="false"
DB_TIMEOUT_MS="5000"

# 3. CACHE (Redis 7+ Session and Distributed State)
REDIS_CACHE_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS="300"
CACHE_KEY_PREFIX="mindos:dev:"
CACHE_ENABLED="true"

# 4. QUEUE (Redis Streams / BullMQ Asynchronous Task Pipeline)
REDIS_QUEUE_URL="redis://localhost:6379/1"
QUEUE_RETRY_LIMIT="3"
QUEUE_DLQ_NAME="mindos:dev:dlq"
QUEUE_CONCURRENCY="2"

# 5. OBJECT STORAGE (Local Disk in dev; S3/GCS in staging/production)
STORAGE_PROVIDER="local_disk" # local_disk | s3_compatible | gcs
STORAGE_BUCKET="mindos-clinical-artifacts-dev"
STORAGE_REGION="af-south-1"
STORAGE_ENCRYPTED="true"

# 6. AUTHENTICATION & IDENTITY
# In production: MUST be >= 32 high-entropy random characters from KMS/Vault
JWT_SECRET="dev-insecure-jwt-secret-min-32-chars-long-standard"
JWT_EXPIRY_MINUTES="60"
SESSION_SECRET="dev-insecure-session-secret-min-32-chars-long-standard"
SESSION_TTL_HOURS="24"
MFA_REQUIRED_PROFESSIONALS="true"

# 7. SECURITY & ENVELOPE ENCRYPTION
# In production: Cloud KMS URI (e.g., kms://projects/p/locations/l/keyRings/r/cryptoKeys/k)
ENCRYPTION_KMS_KEY_REF="kms://mindos-dev/local-key"
AUDIT_INTEGRITY_SALT="dev-audit-salt-minimum-8-chars"
ALLOW_INSECURE_COOKIES="false"
CSRF_ENABLED="true"
RATE_LIMIT_RPM="120"

# 8. AI BOUNDED CONTEXT (Gemini SDK / Approved Provider)
AI_PROVIDER="gemini" # gemini | mock_sandbox
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
AI_MAX_TOKENS="2048"
AI_TEMPERATURE="0.2"
AI_SAFETY_THRESHOLD="BLOCK_MEDIUM"

# 9. PAYMENTS INTEGRATION (M-Pesa Daraja / Sandbox)
PAYMENTS_PROVIDER="mock" # mpesa_daraja | stripe_sandbox | mock
PAYMENTS_MERCHANT_ID="MINDOS_MERCHANT_DEV"

# 10. NOTIFICATIONS INTEGRATION (Africa's Talking SMS / Mock)
NOTIFICATIONS_PROVIDER="mock_console" # sms_africastalking | mock_console
NOTIFICATIONS_SENDER="MindOS-KE"
NOTIFICATIONS_SMS_TTL="10"
NOTIFICATIONS_REAL_DISPATCH="false"

# 11. PRIVACY-PRESERVING ANALYTICS
ANALYTICS_ENABLED="false"
ANALYTICS_ANONYMIZE_IP="true"
ANALYTICS_RETENTION_DAYS="90"

# 12. OBSERVABILITY & TELEMETRY
LOG_LEVEL="info" # debug | info | warn | error
STRUCTURED_LOGS="true"
TELEMETRY_SAMPLE_RATE="1.0"

# 13. CLINICAL GOVERNANCE & REGULATORY COMPLIANCE
KENYA_DHA_CERT_ID="DHA-REG-KE-2026-DEV"
KENYA_ODPC_REG_ID="ODPC-DC-2026-DEV"
SAFETY_POLICY_VERSION="2.0.0"
SAFETY_OVERRIDE_ENABLED="true"
STRICT_RELEASE_GATES="true"
